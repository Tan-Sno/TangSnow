{
  "_说明": "位图**居中裁剪矩形**的共享期望值：Kotlin 侧 `app/src/test/.../util/BitmapsCoverRectTest.kt` 与 Rust 侧 `tests/bitmaps_parity.rs` 读同一份（2026-10-20 审查报告 C-14）。`args` = [srcW, srcH, targetW, targetH]；`expected` = [x, y, w, h]（源图内居中的最大内接矩形）。两侧函数名不同（Kotlin `Bitmaps.centerCropRect` / Rust `center_crop_rect`）但语义必须逐字相同 ⇒ 期望值只写这一份，改它必然两侧一起红。「矩形落在源图内、宽高比与目标一致」是**性质**，两侧各自断言，不在本夹具内。",
  "cases": [
    { "id": "宽幅源图配竖向目标：裁掉左右", "args": [8000, 500, 1080, 2400], "expected": [3887, 0, 225, 500] },
    { "id": "竖幅源图配横向目标：裁掉上下", "args": [500, 8000, 2400, 1080], "expected": [0, 3887, 500, 225] },
    { "id": "方形源配竖向目标：左右各裁一半", "args": [1000, 1000, 1080, 2400], "expected": [275, 0, 450, 1000] },
    { "id": "宽高比恰好相等时原样返回整张", "args": [1080, 2400, 1080, 2400], "expected": [0, 0, 1080, 2400] },
    { "id": "左右裁剪的奇数余数归右侧", "args": [802, 500, 1080, 2400], "expected": [288, 0, 225, 500] },
    { "id": "上下裁剪的奇数余数归下侧", "args": [500, 802, 2400, 1080], "expected": [0, 288, 500, 225] },
    { "id": "1px 方形源图", "args": [1, 1, 1080, 2400], "expected": [0, 0, 1, 1] },
    { "id": "1px 宽源图", "args": [1, 4000, 1080, 2400], "expected": [0, 1999, 1, 2] },
    { "id": "1px 高源图", "args": [4000, 1, 1080, 2400], "expected": [1999, 0, 1, 1] },
    { "id": "极小源图配极大目标", "args": [3, 2, 4000, 4000], "expected": [0, 0, 2, 2] },
    { "id": "非法尺寸：宽高皆零", "args": [0, 0, 0, 0], "expected": [0, 0, 1, 1] },
    { "id": "非法尺寸：源宽为零", "args": [0, 100, 1080, 2400], "expected": [0, 0, 1, 100] },
    { "id": "非法尺寸：源高为零", "args": [100, 0, 1080, 2400], "expected": [0, 0, 100, 1] },
    { "id": "非法尺寸：源宽为负", "args": [-5, 100, 1080, 2400], "expected": [0, 0, 1, 100] },
    { "id": "非法尺寸：目标宽为零", "args": [100, 100, 0, 2400], "expected": [0, 0, 100, 100] },
    { "id": "非法尺寸：目标高为零", "args": [100, 100, 1080, 0], "expected": [0, 0, 100, 100] }
  ]
}
