  {
   "id": "looksLikeUri: 带协议与路径的完整地址",
   "kind": "looksLikeUri",
   "args": [
    "https://example.com/a/b?c=d"
   ],
   "expected": true
  },
  {
   "id": "looksLikeUri: http 前缀",
   "kind": "looksLikeUri",
   "args": [
    "http://example.com"
   ],
   "expected": true
  },
  {
   "id": "looksLikeUri: 非 http 的带协议地址也算网址",
   "kind": "looksLikeUri",
   "args": [
    "ftp://example.com/file"
   ],
   "expected": true
  },
  {
   "id": "looksLikeUri: 只有协议前缀也算网址",
   "kind": "looksLikeUri",
   "args": [
    "http://"
   ],
   "expected": true
  },
  {
   "id": "looksLikeUri: 裸域名",
