{
  "_说明": "搜索引擎引擎表的**共享期望值**：Kotlin 侧 `app/src/test/.../data/SearchEnginesTest.kt` 与 Rust 侧 `tests/search_engines_parity.rs` 读同一份（2026-10-20 审查报告 C-14）。kind ∈ find / findEmptyList / hostMatches / templateHostOf / searchUrl；args 按 kind 顺序（searchUrl 的 args = [模板, 关键词]）；expected 为 null 表示「无结果」。内置引擎**模板表**不在本夹具内 —— 它由 `SearchEngineTableParityTest` 并排比对两侧源码（那是一张表，不是一串用例）。searchUrl 那一组原先是 Kotlin 侧 `PercentEncodeTest.kt` 与 Rust 侧 `search_engines_parity.rs` **各写一份**的镜像期望值（两侧实现逐行等价，却各自钉一份）⇒ 现并入本夹具。",
  "cases": [
    { "id": "find: 按 id 命中内置引擎", "kind": "find", "args": ["baidu"], "expected": "baidu" },
    { "id": "find: 按 id 命中内置引擎（bing_cn）", "kind": "find", "args": ["bing_cn"], "expected": "bing_cn" },
    { "id": "find: 未知 id 回退默认引擎", "kind": "find", "args": ["no-such-engine"], "expected": "bing_cn" },
    { "id": "find: 空 id 回退默认引擎", "kind": "find", "args": [null], "expected": "bing_cn" },
    { "id": "find: 空列表兜底到第一个内置引擎", "kind": "findEmptyList", "args": ["baidu"], "expected": "bing_cn" },

    { "id": "hostMatches: 模板主机命中", "kind": "hostMatches", "args": ["cn.bing.com", "bing_cn", "cn.bing.com"], "expected": true },
    { "id": "hostMatches: 别名主机 bing.com", "kind": "hostMatches", "args": ["bing.com", "bing_cn", "cn.bing.com"], "expected": true },
    { "id": "hostMatches: 别名主机 www.bing.com", "kind": "hostMatches", "args": ["www.bing.com", "bing_cn", "cn.bing.com"], "expected": true },
    { "id": "hostMatches: 别名主机 m.baidu.com", "kind": "hostMatches", "args": ["m.baidu.com", "baidu", "www.baidu.com"], "expected": true },
    { "id": "hostMatches: 别名主机 sm.cn", "kind": "hostMatches", "args": ["sm.cn", "sm", "m.sm.cn"], "expected": true },
    { "id": "hostMatches: 模板主机命中（baidu）", "kind": "hostMatches", "args": ["www.baidu.com", "baidu", "www.baidu.com"], "expected": true },
    { "id": "hostMatches: 无关主机不命中", "kind": "hostMatches", "args": ["evil.com", "bing_cn", "cn.bing.com"], "expected": false },
    { "id": "hostMatches: 后缀相似但不是子域", "kind": "hostMatches", "args": ["bing_cnevil.com", "bing_cn", "cn.bing.com"], "expected": false },
    { "id": "hostMatches: 子域不再被通配（x.cn.bing.com）", "kind": "hostMatches", "args": ["x.cn.bing.com", "bing_cn", "cn.bing.com"], "expected": false },
    { "id": "hostMatches: 子域不再被通配（images.baidu.com）", "kind": "hostMatches", "args": ["images.baidu.com", "baidu", "www.baidu.com"], "expected": false },
    { "id": "hostMatches: 子域不再被通配（evil.bing.com）", "kind": "hostMatches", "args": ["evil.bing.com", "bing_cn", "cn.bing.com"], "expected": false },
    { "id": "hostMatches: 子域不再被通配（bing.com.evil.com）", "kind": "hostMatches", "args": ["bing.com.evil.com", "bing_cn", "cn.bing.com"], "expected": false },
    { "id": "hostMatches: 官方主机 cn.bing.com", "kind": "hostMatches", "args": ["cn.bing.com", "bing_cn", "cn.bing.com"], "expected": true },
    { "id": "hostMatches: 官方主机 global.bing.com", "kind": "hostMatches", "args": ["global.bing.com", "bing", "global.bing.com"], "expected": true },
    { "id": "hostMatches: 官方主机 www.bing.com（国际版）", "kind": "hostMatches", "args": ["www.bing.com", "bing", "global.bing.com"], "expected": true },
    { "id": "hostMatches: 官方主机 baidu.com", "kind": "hostMatches", "args": ["baidu.com", "baidu", "www.baidu.com"], "expected": true },
    { "id": "hostMatches: 官方主机 www.sogou.com", "kind": "hostMatches", "args": ["www.sogou.com", "sogou", "www.sogou.com"], "expected": true },
    { "id": "hostMatches: 官方主机 m.sogou.com", "kind": "hostMatches", "args": ["m.sogou.com", "sogou", "www.sogou.com"], "expected": true },
    { "id": "hostMatches: 官方主机 www.so.com", "kind": "hostMatches", "args": ["www.so.com", "so360", "www.so.com"], "expected": true },
    { "id": "hostMatches: 官方主机 m.so.com", "kind": "hostMatches", "args": ["m.so.com", "so360", "www.so.com"], "expected": true },
    { "id": "hostMatches: 官方主机 m.sm.cn", "kind": "hostMatches", "args": ["m.sm.cn", "sm", "m.sm.cn"], "expected": true },
    { "id": "hostMatches: 官方主机 www.google.com", "kind": "hostMatches", "args": ["www.google.com", "google", "www.google.com"], "expected": true },
    { "id": "hostMatches: 官方主机 duckduckgo.com", "kind": "hostMatches", "args": ["duckduckgo.com", "ddg", "duckduckgo.com"], "expected": true },
    { "id": "hostMatches: 官方主机 html.duckduckgo.com", "kind": "hostMatches", "args": ["html.duckduckgo.com", "ddg", "duckduckgo.com"], "expected": true },
    { "id": "hostMatches: 无关主机（google.com 对 bing_cn）", "kind": "hostMatches", "args": ["google.com", "bing_cn", "cn.bing.com"], "expected": false },
    { "id": "hostMatches: 无关主机（baidu.com.evil.com）", "kind": "hostMatches", "args": ["baidu.com.evil.com", "baidu", "www.baidu.com"], "expected": false },

    { "id": "templateHostOf: 正常模板", "kind": "templateHostOf", "args": ["https://cn.bing.com/search?q={q}"], "expected": "cn.bing.com" },
    { "id": "templateHostOf: 正常模板（baidu）", "kind": "templateHostOf", "args": ["https://www.baidu.com/s?wd={q}"], "expected": "www.baidu.com" },
    { "id": "templateHostOf: 正常模板（sm）", "kind": "templateHostOf", "args": ["http://sm.cn/s?q={q}"], "expected": "sm.cn" },
    { "id": "templateHostOf: 无路径", "kind": "templateHostOf", "args": ["https://a.com"], "expected": "a.com" },
    { "id": "templateHostOf: 结尾斜杠", "kind": "templateHostOf", "args": ["https://a.com/"], "expected": "a.com" },
    { "id": "templateHostOf: 片段标识符", "kind": "templateHostOf", "args": ["https://a.com#x"], "expected": "a.com" },
    { "id": "templateHostOf: 带端口", "kind": "templateHostOf", "args": ["https://a.com:8443/search?q={q}"], "expected": "a.com" },
    { "id": "templateHostOf: 省略协议", "kind": "templateHostOf", "args": ["a.com/search?q={q}"], "expected": "a.com" },
    { "id": "templateHostOf: 带 userinfo", "kind": "templateHostOf", "args": ["https://u:p@a.com/x"], "expected": "a.com" },
    { "id": "templateHostOf: 大小写归一", "kind": "templateHostOf", "args": ["HTTPS://CN.Bing.COM/search?q={q}"], "expected": "cn.bing.com" },
    { "id": "templateHostOf: 空模板无主机", "kind": "templateHostOf", "args": [""], "expected": null },
    { "id": "templateHostOf: 缺主机", "kind": "templateHostOf", "args": ["https:///search?q={q}"], "expected": null },
    { "id": "templateHostOf: 只有端口", "kind": "templateHostOf", "args": ["https://:8080/x"], "expected": null },

    { "id": "searchUrl: q 占位符替换为编码后的关键词", "kind": "searchUrl", "args": ["https://s.test/?q={q}", "abc"], "expected": "https://s.test/?q=abc" },
    { "id": "searchUrl: q 占位符替换为编码后的中文关键词", "kind": "searchUrl", "args": ["https://s.test/?q={q}", "棠雪"], "expected": "https://s.test/?q=%E6%A3%A0%E9%9B%AA" },
    { "id": "searchUrl: 关键词里的空格按 %20 编码", "kind": "searchUrl", "args": ["https://s.test/?q={q}", "棠雪 浏览器"], "expected": "https://s.test/?q=%E6%A3%A0%E9%9B%AA%20%E6%B5%8F%E8%A7%88%E5%99%A8" },
    { "id": "searchUrl: 百分号 s 占位符同样替换", "kind": "searchUrl", "args": ["https://s.test/?wd=%s", "abc"], "expected": "https://s.test/?wd=abc" },
    { "id": "searchUrl: 模板不含占位符时追加 q 参数", "kind": "searchUrl", "args": ["https://s.test/search", "abc"], "expected": "https://s.test/search?q=abc" },
    { "id": "searchUrl: 模板已有查询串时用 &q= 追加", "kind": "searchUrl", "args": ["https://s.test/search?lang=cn", "abc"], "expected": "https://s.test/search?lang=cn&q=abc" },
    { "id": "searchUrl: 空模板回退到内置兜底地址", "kind": "searchUrl", "args": ["", "abc"], "expected": "https://www.bing.com/search?q=abc" },
    { "id": "searchUrl: 关键词前后空白被裁剪", "kind": "searchUrl", "args": ["https://s.test/?q={q}", "  abc  "], "expected": "https://s.test/?q=abc" }
  ]
}
