<?xml version="1.0" encoding="utf-8"?>
<!--
    FileProvider 授权路径白名单。
    仅暴露「本应用自己产生的下载文件」，供系统或其它应用在用户点击
    「打开 / 分享」时按次授权读取（Intent.FLAG_GRANT_READ_URI_PERMISSION）。

    为什么必须用它：Android 7.0（API 24）起，把 file:// 交给外部应用会抛
    FileUriExposedException；而本应用只申请极少量权限（其中**不含任何存储权限**），
    不能靠申请存储权限绕过，故走 content:// 按次授权。
-->
<paths>
    <!-- API 26-28 的下载落点：getExternalFilesDir(DIRECTORY_DOWNLOADS)。
         全仓唯一的 getUriForFile 调用点是 DownloadRepo.externalizableUri
         （把自管下载的 file:// 记录转成 content:// 交付外部应用）——
         2026-09-26 前这里还整目录放开过 external-files/files/cache 三个根，
         经核实均无调用点，已按「实际会交付的落点」最小化收紧；
         将来新增共享落点时必须同步补条目并注明用途。 -->
    <external-files-path
        name="ext_downloads"
        path="Download/" />
</paths>
