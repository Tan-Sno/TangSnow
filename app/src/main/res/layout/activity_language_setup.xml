<?xml version="1.0" encoding="utf-8"?>
<!-- 语言初选页：只在「设备语言既非中文也非英文 且 用户从未选过语言」时出现，
     因此刻意保持极简 —— 一个标题、一句说明、两个选项、一个继续键。
     版式与同意页一致（居中卡片 + 压暗背景）；fitsSystemWindows 与其余布局保持一致，
     由根布局消费 insets（targetSdk ≥ 35 起系统强制 edge-to-edge）。 -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/scrim_strong">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_consent_card"
        android:elevation="10dp"
        android:paddingHorizontal="22dp"
        android:paddingTop="24dp"
        android:paddingBottom="18dp"
        app:layout_constraintWidth_max="440dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/language_setup_title"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="3dp"
            android:text="@string/language_setup_message"
            android:textSize="14sp"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <RadioGroup
            android:id="@+id/languageGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/radioChinese"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/language_setup_zh"
                android:textSize="15sp"
                android:textColor="?attr/colorOnSurface" />

            <RadioButton
                android:id="@+id/radioEnglish"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/language_setup_en"
                android:textSize="15sp"
                android:textColor="?attr/colorOnSurface" />
        </RadioGroup>

        <TextView
            android:id="@+id/btnContinue"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/language_setup_continue"
            android:textSize="15sp"
            android:textColor="?attr/colorOnSurface"
            android:background="@drawable/bg_btn_consent" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
