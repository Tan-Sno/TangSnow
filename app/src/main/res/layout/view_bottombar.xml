<?xml version="1.0" encoding="utf-8"?>
<!--
    底部工具栏：图标 26dp、文字 12sp，整体高度 78dp（与 GeckoView marginBottom 同步）。
    玻璃方块 32x26，仅在标签页 >1 时显示半透明数字。
    六格布局：后退 / 前进 / 收藏 / 分享 / 标签页 / 更多 —— 后退与系统返回键走同一套判定。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="78dp"
    android:orientation="horizontal"
    android:baselineAligned="false"
    android:background="@color/chrome_bar_bg"
    android:gravity="center_vertical"
    android:paddingHorizontal="4dp">

    <!-- 后退（无可退历史且无覆盖层时半透明置灰） -->
    <LinearLayout
        android:id="@+id/cellBack"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="?attr/selectableItemBackgroundBorderless">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="?attr/colorOnSurfaceVariant" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/btn_back"
            android:textSize="12sp"
            android:textColor="?attr/colorOnSurface" />
    </LinearLayout>

    <!-- 前进（无可前进页时半透明置灰） -->
    <LinearLayout
        android:id="@+id/cellForward"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="?attr/selectableItemBackgroundBorderless">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_arrow_forward"
            app:tint="?attr/colorOnSurfaceVariant" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/btn_forward"
            android:textSize="12sp"
            android:textColor="?attr/colorOnSurface" />
    </LinearLayout>

    <!-- 收藏 -->
    <LinearLayout
        android:id="@+id/cellBookmark"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="?attr/selectableItemBackgroundBorderless">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iconBookmark"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_bookmark_border"
            app:tint="?attr/colorOnSurfaceVariant" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/btn_bookmark"
            android:textSize="12sp"
            android:textColor="?attr/colorOnSurface" />
    </LinearLayout>

    <!-- 分享 -->
    <LinearLayout
        android:id="@+id/cellShare"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="?attr/selectableItemBackgroundBorderless">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_share"
            app:tint="?attr/colorOnSurfaceVariant" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/btn_share"
            android:textSize="12sp"
            android:textColor="?attr/colorOnSurface" />
    </LinearLayout>

    <!-- 标签页 -->
    <LinearLayout
        android:id="@+id/cellTabs"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="?attr/selectableItemBackgroundBorderless">

        <!-- 透明玻璃方块：页数以半透明数字呈现在玻璃中间（仅一页时不显示数字） -->
        <FrameLayout
            android:layout_width="32dp"
            android:layout_height="26dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_glass" />

            <TextView
                android:id="@+id/tabsCount"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:alpha="0.72"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/btn_tabs"
            android:textSize="12sp"
            android:textColor="?attr/colorOnSurface" />
    </LinearLayout>

    <!-- 更多（工具栏展开） -->
    <LinearLayout
        android:id="@+id/cellMore"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="?attr/selectableItemBackgroundBorderless">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_expand_less"
            app:tint="?attr/colorOnSurfaceVariant" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/btn_more"
            android:textSize="12sp"
            android:textColor="?attr/colorOnSurface" />
    </LinearLayout>

</LinearLayout>