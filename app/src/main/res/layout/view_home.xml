<?xml version="1.0" encoding="utf-8"?>
<!-- 首页：品牌印记 + 枝头落雪纹样 + 快捷方式（Firefox「定制主页」式），保持留白呼吸感 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home">

    <!-- 右下角海棠纹样（纯装饰，极简风格下隐藏） -->
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/homeMotif"
        android:layout_width="230dp"
        android:layout_height="230dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="-26dp"
        android:layout_marginBottom="-18dp"
        android:src="@drawable/ic_blossom_motif"
        android:importantForAccessibility="no" />

    <!-- 无痕浏览开关（导航栏正下方右上角） -->
    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btnPrivate"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="78dp"
        android:layout_marginEnd="14dp"
        android:src="@drawable/ic_sunglasses"
        app:tint="?attr/colorOnSurfaceVariant"
        android:background="@drawable/bg_private_btn"
        android:contentDescription="@string/btn_private" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="56dp"
        android:orientation="vertical"
        android:gravity="center">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_tangsnow_mark"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/home_wordmark"
            android:textSize="46sp"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="0.24"
            android:textColor="@color/home_wordmark" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/home_tagline"
            android:textSize="13sp"
            android:letterSpacing="0.28"
            android:textColor="@color/home_tagline" />

        <!-- 快捷方式网格（一行四个，定制主页里增删） -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/homeTiles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:paddingHorizontal="28dp"
            android:clipToPadding="false"
            android:overScrollMode="never" />
    </LinearLayout>
</FrameLayout>
