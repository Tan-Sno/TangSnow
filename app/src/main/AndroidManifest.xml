<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Android 17（API 37）起，访问局域网设备（路由器 / NAS / 打印机的管理页）需要该权限，
         否则连接会被内核直接拦掉且**没有任何提示**（TCP 超时 / UDP 报 EPERM）——
         连渲染内核也无法绕过，因为限制在网络栈深处。
         仅在用户要打开局域网地址时按需申请，不在启动时索取
         （见 MainActivity.needsLocalNetworkGrant / UrlUtils.isLocalNetworkAddress）。 -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- 相机仅在扫码时按需申请；无摄像头设备（含部分 ChromeOS）可正常安装 -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".TangSnowApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TangSnow">

        <!-- 启动入口 = 隐私同意页：未同意或政策更新前不得进入浏览器主界面 -->
        <activity
            android:name=".ConsentActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.TangSnow">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.TangSnow">
            <!-- 默认浏览器能力：系统点击 http/https 链接可调起棠雪（配合 ROLE_BROWSER） -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
            <!-- 分享入口：其它应用「分享」纯文本时，棠雪可作为目标打开其中的链接。
                 文本里提取不出 http(s) 链接时不导航（见 MainActivity.handleIntent） -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- 首次启动的「语言初选」：仅当设备语言既非中文也非英文、且用户从未选过语言时
             才会被 ConsentActivity 打开，不需要对外暴露 -->
        <activity
            android:name=".LanguageSetupActivity"
            android:exported="false"
            android:theme="@style/Theme.TangSnow" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.TangSnow" />

        <activity
            android:name=".LibraryActivity"
            android:exported="false"
            android:theme="@style/Theme.TangSnow" />

        <activity
            android:name=".EngineSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.TangSnow" />

        <activity
            android:name=".ExtensionsActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:theme="@style/Theme.TangSnow" />

        <activity
            android:name=".HomeCustomizeActivity"
            android:exported="false"
            android:theme="@style/Theme.TangSnow" />

        <activity
            android:name=".AboutActivity"
            android:exported="false"
            android:theme="@style/Theme.TangSnow" />

        <activity
            android:name=".LegalActivity"
            android:exported="false"
            android:theme="@style/Theme.TangSnow" />

        <!-- 二维码扫描（ZXing Embed 自带取景页；右下角含“相册识别”按钮） -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:exported="false"
            android:screenOrientation="fullSensor"
            tools:ignore="DiscouragedApi"
            tools:replace="android:screenOrientation" />

        <activity
            android:name=".ui.ScanImageActivity"
            android:exported="false"
            android:screenOrientation="fullSensor"
            tools:ignore="DiscouragedApi" />

        <!--
            下载文件对外「打开 / 分享」的唯一出口。
            Android 7.0 起直接传 file:// 给外部应用会抛 FileUriExposedException，
            故统一以 content:// + 按次读取授权交付；authority 跟随 applicationId，
            避免多环境安装冲突。不申请任何存储权限 —— 与「只申请极少量权限」的定位一致
            （完整清单见 README 的「权限」一节与隐私政策第 2 条）。
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
